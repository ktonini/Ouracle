# Fires the wake report every 15 minutes, 4:00-12:45 local time.
# Install: cp to ~/.config/systemd/user/ && systemctl --user enable --now ouracle-wake.timer

[Unit]
Description=Ouracle wake report window

[Timer]
# Every 15 min through the morning, when a night is usually published…
OnCalendar=*-*-* 04..12:0/15:00
# …then hourly into the evening. Oura sometimes classifies a night hours
# late, and the old 04:00–12:45 window simply closed before the data existed,
# so those mornings never produced a notification.
OnCalendar=*-*-* 13..21:00:00
Persistent=false

[Install]
WantedBy=timers.target
