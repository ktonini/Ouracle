# Environment for the Ouracle server container.
# Copy to ~/.config/ouracle/env (rootless) or /etc/ouracle/env (rootful)
# and set a real token:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# Clients authenticate with "Authorization: Bearer <token>" (or the legacy
# X-Cracked-Oura-Token header). Setting either variable enables the API.
#
# Preferred: one named token per device, individually revocable:
#OURACLE_MOBILE_TOKENS=ios-keith:token1,living-room-tv:token2
#
# Or a single shared token:
OURACLE_MOBILE_TOKEN=change-me

# Optional overrides (defaults shown):
#OURACLE_MOBILE_ENABLED=1
#OURACLE_MOBILE_HOST=0.0.0.0
#OURACLE_MOBILE_PORT=8037
#OURACLE_DATA_DIR=/data

# --- Oura API v2 ingest (ouracle-sync) ---
# Personal access token (simplest):
#OURACLE_OURA_TOKEN=

# Or OAuth2 (survives PAT deprecation; rotated refresh token is persisted
# to /data/oura_oauth.json automatically):
#OURACLE_OURA_CLIENT_ID=
#OURACLE_OURA_CLIENT_SECRET=
#OURACLE_OURA_REFRESH_TOKEN=

# Sync tuning (defaults shown). Backfill applies only to a collection's
# first-ever sync; afterwards runs are incremental with this much overlap
# re-fetched to catch Oura rescoring recent days.
#OURACLE_SYNC_BACKFILL_DAYS=3650
#OURACLE_SYNC_OVERLAP_DAYS=3

# Development only: pull Oura's fake sandbox data (any token accepted).
#OURACLE_OURA_SANDBOX=1
