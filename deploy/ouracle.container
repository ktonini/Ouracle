# Podman Quadlet unit for the Ouracle read-only API server.
#
# Rootless install (recommended):
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/ouracle.container ~/.config/containers/systemd/
#   mkdir -p ~/.config/ouracle
#   cp deploy/env.example ~/.config/ouracle/env   # then edit: set the token
#   systemctl --user daemon-reload
#   systemctl --user start ouracle
#   loginctl enable-linger $USER   # keep it running after logout
#
# Rootful: use /etc/containers/systemd/ and /etc/ouracle/env instead,
# and adjust EnvironmentFile= below.

[Unit]
Description=Ouracle read-only API server
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/ouracle:latest
ContainerName=ouracle
EnvironmentFile=%h/.config/ouracle/env
# Lowercase :z — the volume is shared with the ouracle-sync container.
Volume=ouracle-data:/data:z
PublishPort=8037:8037
# The UBI image runs as uid 1001; map the host user onto it so bind-mounted
# data stays owned by you.
UserNS=keep-id:uid=1001,gid=0
# Drop what the process doesn't need.
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=true
# Token-authenticated healthcheck (script avoids shell-quoting layers; the
# Containerfile HEALTHCHECK is ignored by podman's OCI format).
HealthCmd=python /opt/app-root/src/healthcheck.py
HealthInterval=60s
HealthStartPeriod=15s

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target
